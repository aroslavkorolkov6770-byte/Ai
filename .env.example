# Шаблон локальных настроек. Секретов в этом файле нет.
# На текущем этапе launcher использует значения 127.0.0.1 и 8000 напрямую.
AI_HOST=127.0.0.1
AI_PORT=8000
AI_LOG_LEVEL=INFO
AI_ALLOWED_ORIGINS=http://127.0.0.1:8000
AI_MAX_HISTORY_MESSAGES=20

# API читает эти переменные из окружения процесса (этот файл автоматически не загружается).
# Пути необязательны; без них используются файлы внутри проекта.
# AI_QA_CHECKPOINT=C:/path/to/qa.pt
# AI_DIALOGUE_CHECKPOINT=C:/path/to/dialogue.pt
# AI_MEMORY_DB_PATH=C:/path/to/isolated-conversations.sqlite3
